<UserControl x:Class="TimeRenderer.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <!-- 設定パネル (右スライドイン・オーバーレイ) -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="-4" Opacity="0.1"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="320"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsPanelVisible}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="320" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid Width="320">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="*"/>    <!-- Content -->
                </Grid.RowDefinitions>
                
                <!-- ヘッダー -->
                <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="設定" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Content="✕" Command="{Binding ToggleSettingsPanelCommand}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Grid>
                </Border>
                
                <!-- コンテンツ（タブ切替 + 各タブ内は縦スクロール・セクション折りたたみ） -->
                <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControlStyle}">

                <!-- タブ1: 一般（外観・表示設定） -->
                <TabItem Header="一般" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,4,24,24" Background="{DynamicResource SurfaceBrush}">
                    <!-- 外観設定 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="外観" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="ダークモード" Style="{StaticResource FieldLabelStyle}" Margin="0"/>
                            <TextBlock Text="暗い配色テーマを使用します" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <!-- トグルスイッチ -->
                        <ToggleButton Grid.Column="1" IsChecked="{Binding IsDarkMode}" VerticalAlignment="Center"
                                      Width="44" Height="24" Padding="0" BorderThickness="0" Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Grid>
                                                    <Border x:Name="track" Width="44" Height="24" CornerRadius="12"
                                                            Background="{DynamicResource MutedBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                                    <Ellipse x:Name="thumb" Width="18" Height="18"
                                                             Fill="{DynamicResource TextMutedBrush}"
                                                             HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                                                        <Setter TargetName="thumb" Property="Fill" Value="White"/>
                                                        <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumb" Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    </Expander>

                    <!-- 表示設定 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="表示設定" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                    <StackPanel>
                    <!-- 表示時間範囲 -->
                    <Grid Margin="0,0,0,16" Visibility="{Binding IsTimeRangeSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="表示時間範囲" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding StartHourOptions}" SelectedItem="{Binding DisplayStartHour, UpdateSourceTrigger=PropertyChanged}"
                                      Width="70" FontSize="13" />
                            <TextBlock Text="～" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0" />
                            <ComboBox ItemsSource="{Binding EndHourOptions}" SelectedItem="{Binding DisplayEndHour, UpdateSourceTrigger=PropertyChanged}"
                                      Width="70" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <!-- 時刻の刻み幅（ドラッグ操作で丸める単位） -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="時刻の刻み幅" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding SnapMinutesOptions}"
                                      SelectedItem="{Binding SnapMinutes, UpdateSourceTrigger=PropertyChanged}"
                                      Width="70" FontSize="13"
                                      ToolTip="ドラッグでの移動・伸縮・範囲作成で時刻を丸める単位"/>
                            <TextBlock Text="分単位" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- 表示曜日 -->
                    <Grid Margin="0,0,0,16" Visibility="{Binding IsDayOfWeekSettingsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="表示曜日" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,4,16,0" />
                        
                        <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Content="月" IsChecked="{Binding ShowMonday}" Margin="0,0,12,6" FontSize="13"/>
                            <CheckBox Content="火" IsChecked="{Binding ShowTuesday}" Margin="0,0,12,6" FontSize="13"/>
                            <CheckBox Content="水" IsChecked="{Binding ShowWednesday}" Margin="0,0,12,6" FontSize="13"/>
                            <CheckBox Content="木" IsChecked="{Binding ShowThursday}" Margin="0,0,12,6" FontSize="13"/>
                            <CheckBox Content="金" IsChecked="{Binding ShowFriday}" Margin="0,0,12,6" FontSize="13"/>
                            <CheckBox Content="土" IsChecked="{Binding ShowSaturday}" Margin="0,0,12,6" FontSize="13" Foreground="{DynamicResource PrimaryBrush}"/>
                            <CheckBox Content="日" IsChecked="{Binding ShowSunday}" Margin="0,0,12,6" FontSize="13" Foreground="{DynamicResource DangerBrush}"/>
                        </WrapPanel>
                    </Grid>
                    </StackPanel>
                    </Expander>

                    <!-- 離席・中断の検知 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="離席・中断の検知" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="記録中の無操作・スリープ・画面ロックを検知します。記録は自動では変更されず、停止したときに除外するかを確認します。"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="離席を検知する" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsAwayDetectionEnabled}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,16"
                                  Visibility="{Binding IsAwayDetectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="離席とみなす時間" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding AwayThresholdOptions}"
                                              SelectedItem="{Binding AwayThresholdMinutes, UpdateSourceTrigger=PropertyChanged}"
                                              Width="70" FontSize="13"/>
                                    <TextBlock Text="分の無操作" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 検知したときの扱い -->
                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding IsAwayDetectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="検知したときの扱い" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="180" FontSize="13"
                                          ItemsSource="{Binding AwayHandlingOptions}"
                                          SelectedItem="{Binding SelectedAwayHandlingOption}"/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsAwayDetectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="「常に除外する」を選ぶと確認画面を出さずに離席分を差し引きます。差し引いた内容は通知され、Ctrl+Z で元に戻せます。"/>
                        </StackPanel>
                    </Expander>

                    <!-- 使用アプリの記録 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="使用アプリの記録" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="記録の実行中に前面にあったアプリを自動で控えます。予定を右クリック →「この時間の使用アプリ」で、その時間帯に実際に何を使っていたかの内訳を確認できます。"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="使用アプリを記録する" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsAppUsageTrackingEnabled}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="収集するのは出勤から退勤までの間です。未記録の帯を埋めるときの手がかりに使います。データはこの PC の中（データフォルダ）にのみ保存され、60日を過ぎた分は自動で削除されます。"/>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="ウィンドウタイトル（ファイル名・URL など中身が出るもの）を残すのは記録中だけです。記録していない時間は、どのアプリを何分使ったかだけが残ります。"/>
                        </StackPanel>
                    </Expander>

                    <!-- ToDo -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="ToDo" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <!-- クイック追加の記法 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="入力欄で記法を使う" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsTodoQuickSyntaxEnabled}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="ToDo パネルの入力欄で「資料作成 @明日 !高 #開発 ~30m *前日」のように書くと、期限・優先度・カテゴリ・見積もり・通知をその場で指定できます。解釈できない記号はそのまま本文に残ります。入力中は欄の下に解釈結果が出ます。"/>

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                            <!-- 通知 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="既定の通知時刻" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding TodoDefaultRemindHourOptions}"
                                              SelectedItem="{Binding TodoDefaultRemindHour, UpdateSourceTrigger=PropertyChanged}"
                                              Width="70" FontSize="13"/>
                                    <TextBlock Text="時" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="通知の時刻を省略したときに使います（編集ダイアログで通知を入れた直後の初期値、入力欄の「*前日」など）。"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="「あとで」の時間" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding TodoSnoozeOptions}"
                                              SelectedItem="{Binding TodoSnoozeMinutes, UpdateSourceTrigger=PropertyChanged}"
                                              Width="70" FontSize="13"/>
                                    <TextBlock Text="分（バナーの ▾ から他の時間も選べます）" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="通知音を鳴らす" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsTodoReminderSoundEnabled}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="通知時刻から15分以上遅れて気づいた通知は、個別のバナーにはせず「見逃した通知」として1本にまとめて知らせます。"/>

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="ToDo ごとの通知日時とは別に、1日1回「今日が期限」「期限超過」の件数をまとめて知らせます。個別の通知日時を付け忘れていても、その日に片付ける量が一度は目に入ります。"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="まとめて通知する" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsTodoDigestEnabled}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding IsTodoDigestEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="通知する時刻" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding TodoDigestHourOptions}"
                                              SelectedItem="{Binding TodoDigestHour, UpdateSourceTrigger=PropertyChanged}"
                                              Width="70" FontSize="13"/>
                                    <TextBlock Text="時ごろ" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"
                                       Visibility="{Binding IsTodoDigestEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="この時刻より後にアプリを起動した日も、その日ぶんをまだ出していなければ1回だけ通知します。対象が0件の日は通知しません。"/>

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="完了済みを残す期間" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding TodoArchiveRetentionOptions}"
                                              SelectedItem="{Binding TodoArchiveRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                              Width="70" FontSize="13"/>
                                    <TextBlock Text="日" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="この期間を過ぎた完了済みの ToDo は、起動時にアーカイブ（todos-archive.json）へ移します。一覧からは消えますが削除はされず、見積もりの傾向の集計には引き続き使われます。"/>
                        </StackPanel>
                    </Expander>

                    <!-- 勤務（出勤・退勤）の記録 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="勤務の記録（出勤・退勤）" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="ツールバーの「出勤 / 退勤」ボタン、またはホットキー（既定: Ctrl+Alt+S / Ctrl+Alt+E）で登録します。登録した時刻は日・週ビューに横線として表示され、その線のラベルをクリックするとあとから修正できます。押し忘れた日は「出勤 / 退勤」ボタンの右クリックから追加できます。"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="終了を検知する" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsWorkEndDetectionEnabled}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,6"
                                  Visibility="{Binding IsWorkEndDetectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="終了とみなす時間" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding WorkEndThresholdOptions}"
                                              SelectedItem="{Binding WorkEndThresholdMinutes, UpdateSourceTrigger=PropertyChanged}"
                                              Width="70" FontSize="13"/>
                                    <TextBlock Text="分の離席・スリープ" VerticalAlignment="Center" Margin="8,0,0,0"
                                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 確認対象にする離席開始時刻の下限 -->
                            <Grid Margin="0,0,0,16"
                                  Visibility="{Binding IsWorkEndDetectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="確認する時間帯" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="180" FontSize="13"
                                          ItemsSource="{Binding WorkEndEarliestOptions}"
                                          SelectedItem="{Binding SelectedWorkEndEarliestOption}"/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,16"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding IsWorkEndDetectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Text="スリープや長い離席から戻ったときに「最後に操作した時刻で退勤にするか」を確認します。勝手には確定しません。「確認する時間帯」より前に始まった離席（日中の会議・外出など）では確認しません。ただし日付をまたいで戻った場合は時間帯に関係なく確認します。日付をまたいでも退勤が登録されていない場合だけ、その日の最後の記録の時刻で自動的に締めます。"/>

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>

                            <!-- 退勤時のふりかえり -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelG"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="退勤時にふりかえる" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding IsWorkEndReviewEnabled}"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="退勤したときに、その日の勤務時間・記録時間・完了した ToDo の件数を出し、片付かなかった ToDo を明日へ送るか確認します。「今日やる」は日をまたぐと自動で外れるため、手を付けなかったものが黙って消えるのを防ぎます。送るのは「今日やる」の印だけで、期限は変わりません。自動で締めた退勤では出しません。"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                </TabItem>

                <!-- タブ2: 分類（カテゴリ・定型タイトル） -->
                <TabItem Header="分類" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,4,24,24" Background="{DynamicResource SurfaceBrush}">
                    <!-- カテゴリ設定 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="カテゴリ" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                    <StackPanel>
                    <TextBlock Text="色に名前を付けて分類できます（統計に反映）" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 色選択 -->
                                    <ComboBox Grid.Column="0" Width="56" VerticalAlignment="Center" Margin="0,0,8,0"
                                              ItemsSource="{Binding DataContext.PaletteColors, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedValuePath="Code" SelectedValue="{Binding ColorCode}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="20" Height="14" Background="{Binding Brush}" CornerRadius="3"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        ToolTip="{Binding Name}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <!-- 名前 -->
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12" VerticalAlignment="Center"/>
                                    <!-- 削除 -->
                                    <Button Grid.Column="2" Content="✕" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                            Width="24" Height="24" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="＋ カテゴリを追加" Command="{Binding AddCategoryCommand}"
                            Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                    <!-- 記録開始時の既定カテゴリ -->
                    <Separator Margin="0,12,0,10" Background="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="記録開始時の種別" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="「記録開始」で作られる記録に付くカテゴリです（予定から記録を始めた場合はその予定の種別が優先されます）"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Categories}"
                              SelectedItem="{Binding SelectedRecordingCategory}"
                              Height="32" Margin="0,0,0,4">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="20" Height="14" Background="{Binding Brush}" CornerRadius="3"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    </StackPanel>
                    </Expander>

                    <!-- プロジェクトコード設定 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="プロジェクトコード" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                    <StackPanel>
                    <TextBlock Text="記録を案件・プロジェクト単位で集計するためのコードです"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,28,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="92"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="コード" Style="{StaticResource FieldLabelStyle}"/>
                        <TextBlock Grid.Column="1" Text="名称" Style="{StaticResource FieldLabelStyle}" Margin="8,0,0,0"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ProjectCodes}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Code, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12"
                                             VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12"
                                             VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Button Grid.Column="2" Content="✕" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeleteProjectCodeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                            Width="24" Height="24" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Content="＋ プロジェクトコードを追加" Command="{Binding AddProjectCodeCommand}"
                            Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>

                    <Separator Margin="0,12,0,10" Background="{DynamicResource BorderBrush}"/>
                    <TextBlock Text="既定のプロジェクトコード" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4"/>
                    <TextBlock Text="新しい予定・実績と「記録開始」で作る記録に自動設定されます。アイテム編集や記録開始時に変更できます。"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding ProjectCodes}"
                              SelectedItem="{Binding SelectedDefaultProjectCode}"
                              DisplayMemberPath="DisplayName" Height="32" Margin="0,0,0,4"/>
                    </StackPanel>
                    </Expander>

                    <!-- 定型タイトル設定 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="定型タイトル" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                    <StackPanel>
                    <TextBlock Text="タイトル入力欄の候補に常に表示されます" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding PinnedTitles}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Content="✕" Margin="4,0,0,0"
                                            Command="{Binding DataContext.DeletePinnedTitleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButtonStyle}" Foreground="{DynamicResource TextSecondaryBrush}"
                                            Width="24" Height="24" Cursor="Hand"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="＋ 定型タイトルを追加" Command="{Binding AddPinnedTitleCommand}"
                            Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                    </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                </TabItem>

                <!-- タブ3: 定期予定（ルーティン） -->
                <TabItem Header="定期予定" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,4,24,24" Background="{DynamicResource SurfaceBrush}">
                    <!-- 定期予定（ルーティン）設定 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="定期予定（ルーティン）" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                    <StackPanel>
                    <TextBlock Text="決まった曜日・日付の予定を自動生成します（毎週・隔週などのN週ごと／毎月・隔月などのNヶ月ごと）。記録の開始忘れ防止に使えます（開始時刻にリマインダー通知、または自動で記録開始）"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Routines}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding RecurrenceDisplay, Mode=OneWay}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding TimeRangeDisplay, Mode=OneWay}"/>
                                                <Run Text="  "/>
                                                <Run Text="{Binding StartDateDisplay, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock Text="自動開始" FontSize="10" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding IsAutoStart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="無効" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"
                                                       Visibility="{Binding IsEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="編集"
                                                    Command="{Binding DataContext.EditRoutineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    Padding="6,4" FontSize="11" Margin="0,0,4,0" Cursor="Hand"/>
                                            <Button Content="削除"
                                                    Command="{Binding DataContext.DeleteRoutineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource DangerBrush}"
                                                    Padding="6,4" FontSize="11" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="＋ 定期予定を追加" Command="{Binding AddRoutineCommand}"
                            Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,4"/>
                    </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                </TabItem>

                <!-- タブ4: スプリント -->
                <TabItem Header="スプリント" Style="{StaticResource SettingsTabItemStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,4,24,24" Background="{DynamicResource SurfaceBrush}">
                    <!-- スプリント設定 -->
                    <Expander Style="{StaticResource SettingsExpanderStyle}">
                        <Expander.Header>
                            <TextBlock Text="スプリント設定 (手動)" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                        </Expander.Header>
                    <StackPanel>
                        <!-- 手動スプリント一覧リスト -->
                        <ListBox ItemsSource="{Binding ManualSprints}" MaxHeight="120" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="Transparent" Margin="0,0,0,12" Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,6"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Focusable" Value="False"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding StartDate, StringFormat='yyyy/MM/dd', Mode=OneWay}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding EndDate, StringFormat='MM/dd', Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="編集" 
                                                    Command="{Binding DataContext.EditManualSprintCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButtonStyle}" 
                                                    Padding="6,4" FontSize="11" Margin="0,0,4,0" Cursor="Hand"/>
                                            <Button Content="削除" 
                                                    Command="{Binding DataContext.DeleteManualSprintCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButtonStyle}" Foreground="{DynamicResource DangerBrush}" 
                                                    Padding="6,4" FontSize="11" Cursor="Hand"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 追加フォームコントロール -->
                        <Grid Margin="0,0,0,10">
                            <!-- 追加ボタン -->
                            <Button Content="＋ スプリントを追加" 
                                    Command="{Binding ShowAddSprintFormCommand}"
                                    Visibility="{Binding IsAddSprintFormVisible, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                    Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch"/>
                            
                            <!-- インライン追加フォーム -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Background="{DynamicResource BackgroundBrush}"
                                    Visibility="{Binding IsAddSprintFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding FormTitle}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                                    <TextBlock Text="スプリント名" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding NewSprintName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Style="{StaticResource InputTextBoxStyle}"/>
                                    
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="開始日" Style="{StaticResource FieldLabelStyle}"/>
                                            <DatePicker SelectedDate="{Binding NewSprintStartDate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="終了日" Style="{StaticResource FieldLabelStyle}"/>
                                            <DatePicker SelectedDate="{Binding NewSprintEndDate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="キャンセル" Command="{Binding HideAddSprintFormCommand}" Style="{StaticResource BaseButtonStyle}" Cursor="Hand"/>
                                        <Button Grid.Column="2" Content="保存" Command="{Binding SaveNewSprintCommand}" Style="{StaticResource PrimaryButtonStyle}" Cursor="Hand"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
                </TabItem>

                </TabControl>

            </Grid>
        </Border>
</UserControl>
