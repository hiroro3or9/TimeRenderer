<UserControl x:Class="TimeRenderer.Views.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsTabStop="False">
    <!--
        通知をメインコンテンツの上へ重ねるホスト。
        通常通知は右上のスクロール可能なカード、データ保全の通知は横幅いっぱいの継続表示にする。
        背景を持たない領域はヒットテストされないため、通知以外の場所では背面をそのまま操作できる。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- データ読み込み・復元の異常は、自動で消えない継続通知として残す -->
        <Border Grid.Row="0" Margin="12,10,12,0"
                Style="{StaticResource WarningNotificationCardStyle}"
                Visibility="{Binding HasDataNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="データに関するお知らせ" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource WarningTextBrush}"/>
                    <TextBlock Text="{Binding DataNotice}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Foreground="{DynamicResource WarningTextBrush}" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="データフォルダを開く" Padding="10,4" Margin="0,0,6,0"
                            Command="{Binding OpenDataFolderCommand}"/>
                    <Button Content="✕" Width="26" Padding="0,4" ToolTip="この通知を閉じる"
                            Command="{Binding DismissDataNoticeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 通常通知は高さを奪わず、最大高を超えた分だけこの領域内でスクロールする -->
        <ScrollViewer Grid.Row="1" Width="520" MaxHeight="430" Margin="12"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 定期予定リマインダー -->
                <ItemsControl ItemsSource="{Binding PendingReminders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource NotificationCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               VerticalAlignment="Top" Margin="0,2,10,0"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="予定の開始時刻です" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                                            Style="{StaticResource IconButtonStyle}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Command="{Binding DataContext.DismissReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="記録開始"
                                            HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,4"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding DataContext.StartReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ToDo リマインダー -->
                <ItemsControl ItemsSource="{Binding PendingTodoReminders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource NotificationCardStyle}"
                                    Background="{DynamicResource TodoReminderSubtleBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               VerticalAlignment="Top" Margin="0,2,10,0"
                                               Foreground="{DynamicResource TodoDueTodayBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="ToDo の通知" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                                            Style="{StaticResource IconButtonStyle}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            ToolTip="この通知を閉じる（ToDo は残ります）"
                                            Command="{Binding DataContext.DismissTodoReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                        <Button Content="記録開始" Padding="10,4" Margin="0,0,6,0"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Command="{Binding DataContext.StartRecordingFromTodoReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="完了" Padding="10,4" Margin="0,0,6,0"
                                                Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding DataContext.CompleteTodoReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="{Binding DataContext.TodoSnoozeLabel, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Padding="10,4" Style="{StaticResource BaseButtonStyle}"
                                                ToolTip="この時間だけ先送りして、もう一度通知します"
                                                Command="{Binding DataContext.SnoozeTodoReminderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                Width="24" Height="26" Padding="0" Margin="2,0,0,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                ToolTip="先送りする時間を選ぶ"
                                                Click="TodoSnoozeMenuButton_Click">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="5分後" Tag="5" Click="TodoSnoozeMenuItem_Click"/>
                                                    <MenuItem Header="15分後" Tag="15" Click="TodoSnoozeMenuItem_Click"/>
                                                    <MenuItem Header="30分後" Tag="30" Click="TodoSnoozeMenuItem_Click"/>
                                                    <MenuItem Header="1時間後" Tag="60" Click="TodoSnoozeMenuItem_Click"/>
                                                    <MenuItem Header="3時間後" Tag="180" Click="TodoSnoozeMenuItem_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="明日の朝" Tag="tomorrow" Click="TodoSnoozeMenuItem_Click"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- アプリを閉じている間に見逃した通知 -->
                <Border Style="{StaticResource NotificationCardStyle}"
                        Background="{DynamicResource TodoReminderSubtleBrush}"
                        Visibility="{Binding HasTodoMissedNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   VerticalAlignment="Top" Margin="0,2,10,0"
                                   Foreground="{DynamicResource TodoOverdueBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TodoMissedNotice}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                        <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="この通知を閉じる（ToDo は残ります）"
                                Command="{Binding DismissTodoMissedNoticeCommand}"/>
                        <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="確認する"
                                HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ShowMissedTodosCommand}"/>
                    </Grid>
                </Border>

                <!-- 1日1回の ToDo まとめ通知 -->
                <Border Style="{StaticResource NotificationCardStyle}"
                        Background="{DynamicResource TodoReminderSubtleBrush}"
                        Visibility="{Binding HasTodoDigest, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   VerticalAlignment="Top" Margin="0,2,10,0"
                                   Foreground="{DynamicResource TodoDueTodayBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TodoDigestNotice}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                        <Button Grid.Column="2" Content="✕" Width="24" Height="24"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="この通知を閉じる"
                                Command="{Binding DismissTodoDigestCommand}"/>
                        <Button Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Content="ToDo を開く"
                                HorizontalAlignment="Right" Margin="0,8,0,0" Padding="12,4"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding FocusQuickAddTodoCommand}"/>
                    </Grid>
                </Border>

                <!-- 自動記録開始は数秒で自動的に消える -->
                <Border Style="{StaticResource NotificationCardStyle}"
                        Background="{DynamicResource PrimarySubtleBrush}"
                        BorderBrush="{DynamicResource PrimaryBrush}"
                        Visibility="{Binding HasAutoStartNotice, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding AutoStartNotice}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 記録中の離席通知 -->
                <Border Style="{StaticResource WarningNotificationCardStyle}"
                        Visibility="{Binding ShowAwayBanner, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding AwayBannerText}" FontSize="12" TextWrapping="Wrap"
                                   VerticalAlignment="Center" Foreground="{DynamicResource WarningTextBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
