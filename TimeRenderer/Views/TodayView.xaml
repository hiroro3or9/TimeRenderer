<UserControl x:Class="TimeRenderer.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TimeRenderer.Helpers">
    <UserControl.Resources>
        <Style x:Key="TodayCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      helpers:ScrollViewerHelper.EnableMiddleButtonScroll="True">
            <StackPanel Margin="24" MaxWidth="1080" HorizontalAlignment="Center">

                <!-- 今やっていること／次にやること -->
                <Border Background="{DynamicResource PrimarySubtleBrush}" BorderBrush="{DynamicResource PrimaryBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid Visibility="{Binding IsRecording, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="記録中" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                                <TextBlock Text="{Binding RecordingTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding RecordingDuration, StringFormat=経過 {0:hh\\:mm\\:ss}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="■ 停止" Command="{Binding ToggleRecordingCommand}"
                                    Style="{StaticResource BaseButtonStyle}" Padding="16,8" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Visibility="{Binding IsRecording, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                            <Grid Visibility="{Binding HasTodayNextPlan, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="次の予定" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding TodayNextPlan.Item.Title}" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding TodayNextPlan.TimeText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TodayNextPlan.CategoryName}" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="記録開始" Style="{StaticResource PrimaryButtonStyle}" Padding="16,8"
                                        Command="{Binding StartRecordingFromItemCommand}"
                                        CommandParameter="{Binding TodayNextPlan.Item}" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Visibility="{Binding HasTodayNextPlan, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                                <TextBlock Text="次の予定はありません" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="「今日やる」ToDoから始めるか、上部の記録開始を使えます" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 今日の4指標 -->
                <UniformGrid Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource TodayCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="実績" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TodayRecordedSummaryText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TodayCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="予定" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TodayPlannedSummaryText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TodayCardStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="未記録" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TodayGapSummaryText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="WorkloadCard" Style="{StaticResource TodayCardStyle}">
                        <StackPanel>
                            <TextBlock Text="今日の負荷" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="WorkloadText" Text="{Binding TodayWorkloadSummaryText}" FontSize="14" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 予定とToDo -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource TodayCardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="今日の予定" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="枠線＝予定" HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>

                            <TextBlock Text="予定はありません" Margin="0,10" TextAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding HasTodayPlans, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>

                            <ItemsControl ItemsSource="{Binding TodayPlanItems}"
                                          Visibility="{Binding HasTodayPlans, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{Binding Item.BackgroundColor}" BorderThickness="2,1,1,1" CornerRadius="5"
                                                Background="{DynamicResource BackgroundBrush}" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding TimeText}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DurationText}" FontSize="10"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Item.Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border Background="{DynamicResource PrimarySubtleBrush}" CornerRadius="3" Padding="5,1" Margin="6,0,0,0"
                                                                Visibility="{Binding IsNext, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="次" FontSize="9" Foreground="{DynamicResource PrimaryBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding CategoryName}" FontSize="10" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Content="開始" Padding="10,4" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.StartRecordingFromItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding Item}" Style="{StaticResource BaseButtonStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource TodayCardStyle}" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="今日やる ToDo" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{Binding TodayTodoItems.Count, StringFormat={}{0}件}" HorizontalAlignment="Right" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>

                            <TextBlock Text="「今日やる」にしたToDoはありません" Margin="0,10" TextAlignment="Center"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="{Binding HasTodayTodos, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>

                            <ItemsControl ItemsSource="{Binding TodayTodoItems}"
                                          Visibility="{Binding HasTodayTodos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding ProgressDisplay}" FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Text="{Binding DueDisplay}" FontSize="10" Margin="8,0,0,0"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="開始" Padding="9,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.StartRecordingFromTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource BaseButtonStyle}"/>
                                                <Button Grid.Column="2" Content="完了" Padding="9,4" Margin="6,0,0,0"
                                                        Command="{Binding DataContext.ToggleTodoCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource BaseButtonStyle}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Content="日ビューで詳しく確認" Command="{Binding OpenTodayDayViewCommand}"
                        Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Center" Margin="0,18,0,8" Padding="18,7"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
