<Window x:Class="TimeRenderer.Views.Dialogs.TodoPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToDo を選ぶ" Height="440" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,12"
                   FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>

        <!-- 未完了の ToDo だけを出す。ダブルクリックでそのまま確定できる -->
        <ListBox x:Name="TodoList" Grid.Row="1"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="TodoList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="2,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,1,8,1"
                                Background="{Binding Brush}"/>

                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>

                        <TextBlock Grid.Column="2" Text="{Binding DueDisplay}" FontSize="10"
                                   VerticalAlignment="Center" Margin="8,0,4,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Width="100" Height="36" Margin="0,0,12,0"
                    IsCancel="True" Click="CancelButton_Click" Style="{StaticResource BaseButtonStyle}"/>
            <Button Content="OK" Width="100" Height="36" IsDefault="True"
                    Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
