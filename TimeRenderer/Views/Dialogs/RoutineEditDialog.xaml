<Window x:Class="TimeRenderer.Views.Dialogs.RoutineEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="定期予定の編集" Height="780" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 入力欄（項目が増えても収まるようスクロールさせる） -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,8,0">

        <!-- タイトル（手入力＋ドロップダウン候補） -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="TitleCombo" IsEditable="True" FontSize="14" Padding="6,6"
                      IsTextSearchEnabled="False" MaxDropDownHeight="240"/>
        </StackPanel>

        <!-- 繰り返し方 -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="繰り返し" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="RecurrenceCombo" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="6,6"
                      DisplayMemberPath="Label" SelectionChanged="RecurrenceCombo_SelectionChanged"/>
        </StackPanel>

        <!-- 曜日指定（毎週・N週ごと） -->
        <StackPanel x:Name="WeeklyPanel" Margin="0,0,0,14">
            <TextBlock Text="間隔" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="WeekIntervalCombo" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="6,6"
                      DisplayMemberPath="Label"/>
            <TextBlock Text="間隔の起点は下の開始日です（開始日を含む週を1週目として数えます）"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 第N曜日指定（毎月 第1・第3 月曜 など） -->
        <StackPanel x:Name="MonthlyWeekdayPanel" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock Text="間隔" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="MonthWeekIntervalCombo" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="6,6"
                      DisplayMemberPath="Label"/>

            <TextBlock Text="繰り返す週" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0"/>
            <WrapPanel>
                <CheckBox x:Name="Week1Check" Content="第1" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="Week2Check" Content="第2" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="Week3Check" Content="第3" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="Week4Check" Content="第4" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="Week5Check" Content="第5" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="WeekLastCheck" Content="最終" Margin="0,4,0,0" VerticalContentAlignment="Center"/>
            </WrapPanel>
            <TextBlock Text="第5週が無い月は「第5」の回を飛ばします。毎月必ず入れたい場合は「最終」を選びます"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 日付指定（毎月・Nヶ月ごと） -->
        <StackPanel x:Name="MonthlyPanel" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock Text="間隔" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="MonthIntervalCombo" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="6,6"
                      DisplayMemberPath="Label"/>

            <TextBlock Text="繰り返す日" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,0"/>
            <ComboBox x:Name="DayOfMonthCombo" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="6,6"
                      MaxDropDownHeight="240" DisplayMemberPath="Label"/>
            <TextBlock Text="指定した日が無い月（2月の30日など）は、その月の末日に繰り下げます。間隔の起点は下の開始日です"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- 曜日（毎週・第N曜日の両方で使う） -->
        <StackPanel x:Name="DaysOfWeekPanel" Margin="0,0,0,14">
            <TextBlock Text="繰り返す曜日" Style="{StaticResource FieldLabelStyle}"/>
            <WrapPanel>
                <CheckBox x:Name="MonCheck" Content="月" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="TueCheck" Content="火" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="WedCheck" Content="水" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="ThuCheck" Content="木" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="FriCheck" Content="金" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="SatCheck" Content="土" Margin="0,4,14,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="SunCheck" Content="日" Margin="0,4,0,0" VerticalContentAlignment="Center"/>
            </WrapPanel>
        </StackPanel>

        <!-- 開始日 -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="開始日" Style="{StaticResource FieldLabelStyle}"/>
            <DatePicker x:Name="StartDatePicker" Width="160" HorizontalAlignment="Left"
                        Padding="4,4" VerticalContentAlignment="Center"/>
            <TextBlock Text="この日より前には予定を表示しません（過去にも表示したい場合は日付を遡って設定します）"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 規則的な休み（N回に1回は開催されない予定） -->
        <StackPanel Margin="0,0,0,14">
            <CheckBox x:Name="SkipEnabledCheck" Content="一定の回数ごとに1回休む" VerticalContentAlignment="Center"
                      Checked="SkipEnabledCheck_Changed" Unchecked="SkipEnabledCheck_Changed"/>
            <StackPanel x:Name="SkipDetailPanel" Orientation="Horizontal" Margin="16,8,0,0"
                        IsEnabled="{Binding IsChecked, ElementName=SkipEnabledCheck}">
                <ComboBox x:Name="SkipEveryCombo" Width="120" FontSize="14" Padding="6,6"
                          DisplayMemberPath="Label" SelectionChanged="SkipEveryCombo_SelectionChanged"/>
                <TextBlock Text="のうち" VerticalAlignment="Center" Margin="8,0"/>
                <ComboBox x:Name="SkipIndexCombo" Width="120" FontSize="14" Padding="6,6"
                          DisplayMemberPath="Label"/>
                <TextBlock Text="を休む" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="回数は開始日以降の1回目から数えます（例: 「2回」「2回目」なら隔回で休みになります）"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="16,6,0,0"/>
        </StackPanel>

        <!-- 開始時刻 -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="開始時刻" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="StartHourCombo" Width="80" FontSize="14" Padding="6,6"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontSize="16" FontWeight="Bold"/>
                <ComboBox x:Name="StartMinuteCombo" Width="80" FontSize="14" Padding="6,6"/>
            </StackPanel>
        </StackPanel>

        <!-- 終了時刻 -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="終了時刻" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="EndHourCombo" Width="80" FontSize="14" Padding="6,6"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontSize="16" FontWeight="Bold"/>
                <ComboBox x:Name="EndMinuteCombo" Width="80" FontSize="14" Padding="6,6"/>
            </StackPanel>
        </StackPanel>

        <!-- カテゴリ -->
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="カテゴリ" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="ColorCombo" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="6,6">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" Background="{Binding Brush}" CornerRadius="3" Margin="0,0,8,0" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- 記録開始の挙動 -->
        <StackPanel Margin="0,0,0,8">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
            <CheckBox x:Name="AutoStartCheckBox" Content="予定時刻になったら自動で記録を開始する" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
            <TextBlock Text="オフの場合は開始時刻にリマインダー通知を表示します（記録開始ボタンをワンクリックで押せます）"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <CheckBox x:Name="ForceStartCheckBox" Content="記録中でも強制的に開始する" VerticalContentAlignment="Center" Margin="16,0,0,4"
                      IsEnabled="{Binding IsChecked, ElementName=AutoStartCheckBox}"/>
            <TextBlock Text="オンの場合、自動開始の時刻に別の記録中でも現在の記録を停止・保存して開始します"
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="16,0,0,12"/>
            <CheckBox x:Name="EnabledCheckBox" Content="この定期予定を有効にする" VerticalContentAlignment="Center" IsChecked="True"/>
        </StackPanel>

        </StackPanel>
        </ScrollViewer>

        <!-- ボタン -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Width="100" Height="36" Margin="0,0,12,0"
                    Click="CancelButton_Click" Style="{StaticResource BaseButtonStyle}"/>
            <Button Content="OK" Width="100" Height="36"
                    Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
