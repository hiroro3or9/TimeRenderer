<Window x:Class="TimeRenderer.Views.Dialogs.RoutineScopeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="定期予定" Height="200" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="{DynamicResource BackgroundBrush}">
    <!--
        定期予定の一部（ある日の1件）に対する操作で、
        「その日だけ」か「定期予定全体」かをユーザーに選ばせるダイアログ。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" FontSize="14"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="この日のみ" IsDefault="True" Click="ThisDayButton_Click"
                    MinWidth="96" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="定期予定全体" Click="WholeSeriesButton_Click"
                    MinWidth="96" Margin="0,0,10,0" Style="{StaticResource BaseButtonStyle}"/>
            <Button Content="キャンセル" IsCancel="True" MinWidth="80" Style="{StaticResource BaseButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
