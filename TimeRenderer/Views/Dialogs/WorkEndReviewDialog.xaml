<Window x:Class="TimeRenderer.Views.Dialogs.WorkEndReviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日のふりかえり" Height="620" Width="480" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <!--
        退勤の直後に一度だけ出す。
        上半分は「今日どうだったか」、下半分は「明日へ送るか」。
        判断を求めるのは下半分だけなので、上は読み流せる密度に留める。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadlineText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>

        <!--
            今日どうだったか。実績（自動で出る数字）と、ふりかえりの一言（自分で書くもの）を並べる。
            一言は勤務記録に付く。予定にも ToDo にも紐づかない文章の置き場はここだけなので、
            退勤という1日で唯一はっきりした区切りで書けるようにしている。
        -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">

        <!-- 今日の実績 -->
        <Border CornerRadius="4" Padding="12,10" Margin="0,0,0,12"
                Background="{DynamicResource MutedBackgroundBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="勤務" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="WorkText" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="WorkRangeText" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="記録した時間" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="RecordedText" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="RecordedRatioText" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="完了した ToDo" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="CompletedText" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!--
            ふりかえりの一言。空のままでも構わないので、フォーカスは既定ボタンに残す
            （Enter だけで確定できる流れを崩さないため）
        -->

        <!--
            今日のコミット。ふりかえりを書く前の材料として、一言の欄のすぐ上に置く。
            白紙に向かって思い出すより、並んでいるものを見ながら書くほうがはるかに早い。
            「貼る」で一言の欄へそのまま流し込めるようにしてあるのは、
            結局そのまま書き写す日が多いため。
        -->
        <StackPanel x:Name="CommitPanel" Margin="0,0,0,12" Visibility="Collapsed">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="CommitHeadText" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Grid.Column="1" x:Name="PasteCommitsButton" Content="ひとことへ貼る"
                        Padding="8,3" FontSize="11" Cursor="Hand"
                        Style="{StaticResource GhostButtonStyle}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Click="PasteCommitsButton_Click"/>
            </Grid>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource SurfaceBrush}" Padding="4" MaxHeight="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommitList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11"
                                               MinWidth="38" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subject}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding RepositoryName}" FontSize="10"
                                               Margin="8,1,0,0" MaxWidth="110" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <TextBlock Text="今日のひとこと（任意）" FontSize="12" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox x:Name="NoteTextBox" Height="58" Padding="8,6" FontSize="13"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

        </StackPanel>

        <!-- 繰り越しの見出し -->
        <Grid Grid.Row="2" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="CarryOverHeadText" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Grid.Column="1" x:Name="ToggleAllButton" Content="すべて外す" Padding="8,3" FontSize="11"
                    Cursor="Hand" Style="{StaticResource GhostButtonStyle}"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    Click="ToggleAllButton_Click"/>
        </Grid>

        <!-- 明日へ送る候補 -->
        <Border Grid.Row="3" x:Name="ListPanel"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource SurfaceBrush}" Padding="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CarryOverList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Cursor="Hand"
                                              VerticalAlignment="Center" Margin="0,0,8,0"
                                              Checked="CarryOverCheck_Changed" Unchecked="CarryOverCheck_Changed"/>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8C9;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                       VerticalAlignment="Center" Margin="0,0,4,0"
                                                       Foreground="{DynamicResource TodoHighPriorityBrush}"
                                                       Visibility="{Binding IsHighPriority, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DetailText}" FontSize="10" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="3" Padding="6,2" VerticalAlignment="Center"
                                            Background="{DynamicResource MutedBackgroundBrush}">
                                        <TextBlock Text="{Binding ReasonText}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 候補が無いときはリストの代わりにこちらを出す -->
        <Border Grid.Row="3" x:Name="EmptyPanel" CornerRadius="4" Visibility="Collapsed"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Background="{DynamicResource SurfaceBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           HorizontalAlignment="Center" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock x:Name="EmptyText" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="送るのは「今日やる」の印だけです。期限は変わりません。Ctrl+Z で元に戻せます。"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="そのまま閉じる" Click="CloseButton_Click" Padding="14,6" Margin="0,0,8,0"
                    IsCancel="True" Style="{StaticResource BaseButtonStyle}"/>
            <Button x:Name="CarryOverButton" Click="CarryOverButton_Click" Padding="14,6" IsDefault="True"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
