<Window x:Class="TimeRenderer.Views.Dialogs.GapFillDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="この時間の作業から埋める" Height="660" Width="470" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundBrush}">

    <!--
        記録が抜けている時間帯に、その時間使っていたアプリを証拠として見せたうえで、
        記録を作るかどうかだけを聞く。離席の確認ダイアログと同じ形。
        タイトルとカテゴリは推測を入れてあるが、確定はユーザーが押すまでしない。
    -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 入力内容は小さい画面でも縦スクロールできるようにし、ボタンは下部へ固定する -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeadlineText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>

        <TextBlock Grid.Row="1" x:Name="SummaryText" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>

        <!-- この時間帯に使っていたアプリ -->
        <Border Grid.Row="2" x:Name="UsagePanel"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                Background="{DynamicResource SurfaceBrush}" Padding="4" MinHeight="120" MaxHeight="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="UsageList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="8,7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding AppName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding DurationText}" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,8,0"/>
                                            <TextBlock Text="{Binding PercentText}" FontSize="12" MinWidth="36"
                                                       TextAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="4"
                                                 Margin="0,5,0,0" BorderThickness="0"
                                                 Background="{DynamicResource BorderBrush}"
                                                 Foreground="{DynamicResource PrimaryBrush}"/>
                                    <!-- タイトルは記録中のぶんしか残らないので、あるときだけ出す -->
                                    <TextBlock Text="{Binding SampleTitle}" FontSize="11" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSampleTitle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>


        <!--
            この時間に作られたコミット。
            アプリ名は「どこで作業していたか」しか語らないので、
            開発の時間帯ではこちらのほうが手がかりとして強い。
        -->
        <StackPanel Grid.Row="3" x:Name="CommitPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CommitHeadText" FontSize="12" Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                    Background="{DynamicResource SurfaceBrush}" Padding="4" MaxHeight="160">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CommitList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="11"
                                               MinWidth="38" VerticalAlignment="Top" Margin="0,1,8,0"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Subject}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding OriginText}" FontSize="10" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- タイトル：コミットと、過去に同じアプリを使っていた時間帯へ付けていたものを候補に出す -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="TitleCombo" IsEditable="True" FontSize="14" Padding="6,6"
                      IsTextSearchEnabled="False" MaxDropDownHeight="200"/>
            <TextBlock x:Name="GuessNoteText" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- カテゴリ -->
        <StackPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock Text="カテゴリ" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="CategoryCombo" Width="220" HorizontalAlignment="Left" FontSize="14" Padding="6,6">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" Background="{Binding Brush}" CornerRadius="3"
                                    Margin="0,0,8,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- プロジェクトコード -->
        <StackPanel Grid.Row="6" Margin="0,12,0,0">
            <TextBlock Text="プロジェクトコード" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="ProjectCodeCombo" Width="280" HorizontalAlignment="Left"
                      FontSize="14" Padding="6,6" DisplayMemberPath="DisplayName"/>
        </StackPanel>

        </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="キャンセル" Click="CancelButton_Click" Padding="14,6" Margin="0,0,8,0"
                    IsCancel="True" Style="{StaticResource BaseButtonStyle}"/>
            <Button x:Name="CreateButton" Content="記録を作る" Click="CreateButton_Click" Padding="14,6"
                    IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
