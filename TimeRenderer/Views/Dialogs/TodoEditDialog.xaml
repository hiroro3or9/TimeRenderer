<Window x:Class="TimeRenderer.Views.Dialogs.TodoEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToDo の編集" Height="880" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル（手入力＋ドロップダウン候補：定型タイトル・直近1か月のタイトル） -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="TitleCombo" IsEditable="True" FontSize="14" Padding="6,6"
                      IsTextSearchEnabled="False" MaxDropDownHeight="240"/>
        </StackPanel>

        <!-- 期限（未設定なら日/週ビューには並ばず、パネルにだけ残る） -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="期限" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Orientation="Horizontal">
                <DatePicker x:Name="DueDatePicker" Width="160" Padding="4,4" VerticalContentAlignment="Center"/>
                <Button Content="今日" Width="56" Height="30" Margin="8,0,0,0"
                        Click="TodayButton_Click" Style="{StaticResource BaseButtonStyle}"/>
                <Button Content="明日" Width="56" Height="30" Margin="4,0,0,0"
                        Click="TomorrowButton_Click" Style="{StaticResource BaseButtonStyle}"/>
                <Button Content="なし" Width="56" Height="30" Margin="4,0,0,0"
                        Click="ClearDueButton_Click" Style="{StaticResource BaseButtonStyle}"
                        ToolTip="期限を外す（一覧には残ります）"/>
            </StackPanel>
        </StackPanel>

        <!-- 優先度 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="優先度" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PriorityHighRadio" Content="高" GroupName="TodoPriority"
                             Style="{StaticResource SegmentedLeftStyle}"/>
                <RadioButton x:Name="PriorityNormalRadio" Content="標準" GroupName="TodoPriority"
                             Style="{StaticResource SegmentedMiddleStyle}"/>
                <RadioButton x:Name="PriorityLowRadio" Content="低" GroupName="TodoPriority"
                             Style="{StaticResource SegmentedRightStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- 見積もり時間（この ToDo で記録した時間と並べて進捗として見せる） -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="見積もり時間" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="EstimateCombo" Width="140" FontSize="14" Padding="6,6"
                          DisplayMemberPath="Label"/>
                <TextBlock x:Name="RecordedText" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
            <!-- 過去の完了分から見た傾向。見積もる、その瞬間に目に入るのが要点 -->
            <TextBlock x:Name="AccuracyText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
        </StackPanel>

        <!-- 繰り返し（完了すると次回分が自動で作られる） -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="繰り返し" Style="{StaticResource FieldLabelStyle}"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="RecurrenceCombo" Width="110" FontSize="14" Padding="6,6"
                          DisplayMemberPath="Label" SelectionChanged="RecurrenceCombo_SelectionChanged"/>
                <TextBlock Text="間隔" VerticalAlignment="Center" Margin="12,0,6,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <ComboBox x:Name="RecurrenceIntervalCombo" Width="70" FontSize="14" Padding="6,6"/>
            </StackPanel>

            <!-- 週ごとのときだけ：曜日を決めると「毎週 月・水・金」のように週に複数回にできる -->
            <StackPanel x:Name="RecurrenceDaysPanel" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="曜日" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <CheckBox x:Name="DayMonCheck" Content="月" Checked="RecurrenceDay_Changed" Unchecked="RecurrenceDay_Changed" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="DayTueCheck" Content="火" Checked="RecurrenceDay_Changed" Unchecked="RecurrenceDay_Changed" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="DayWedCheck" Content="水" Checked="RecurrenceDay_Changed" Unchecked="RecurrenceDay_Changed" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="DayThuCheck" Content="木" Checked="RecurrenceDay_Changed" Unchecked="RecurrenceDay_Changed" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="DayFriCheck" Content="金" Checked="RecurrenceDay_Changed" Unchecked="RecurrenceDay_Changed" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="DaySatCheck" Content="土" Checked="RecurrenceDay_Changed" Unchecked="RecurrenceDay_Changed" Margin="0,0,6,0" VerticalContentAlignment="Center"/>
                <CheckBox x:Name="DaySunCheck" Content="日" Checked="RecurrenceDay_Changed" Unchecked="RecurrenceDay_Changed" VerticalContentAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="RecurrenceFromCompletionCheckBox" Content="完了した日から次回の期限を数える"
                      VerticalContentAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="RecurrenceHint" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="完了すると次回分が自動で作られます。期限日から数えるので、遅れて完了しても曜日や日付はずれません。"/>
        </StackPanel>

        <!-- カテゴリ（チップの色と、この ToDo から記録を始めたときの色になる） -->
        <StackPanel Grid.Row="5" Margin="0,0,0,16">
            <TextBlock Text="カテゴリ" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="ColorCombo" Width="200" HorizontalAlignment="Left" FontSize="14" Padding="6,6"
                      SelectionChanged="ColorCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="20" Height="20" Background="{Binding Brush}" CornerRadius="3" Margin="0,0,8,0" BorderBrush="#CCCCCC" BorderThickness="1"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!--
            通知。期限は日付しか持たないため、いつ思い出したいかはここで別に決める
            （期限の数日前に一度だけ知らせる、といった使い方ができる）。
        -->
        <StackPanel Grid.Row="6" Margin="0,0,0,16">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
            <CheckBox x:Name="RemindCheckBox" Content="指定した日時に通知する" VerticalContentAlignment="Center"
                      Margin="0,0,0,8" Checked="RemindCheckBox_Checked"/>
            <StackPanel x:Name="RemindPanel" Orientation="Horizontal"
                        IsEnabled="{Binding IsChecked, ElementName=RemindCheckBox}">
                <DatePicker x:Name="RemindDatePicker" Width="160" Padding="4,4" VerticalContentAlignment="Center"/>
                <ComboBox x:Name="RemindHourCombo" Width="70" FontSize="14" Padding="6,6" Margin="8,0,0,0"/>
                <TextBlock Text=":" VerticalAlignment="Center" Margin="6,0" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox x:Name="RemindMinuteCombo" Width="70" FontSize="14" Padding="6,6"/>
            </StackPanel>
        </StackPanel>

        <!-- サブタスク（手順の分解。期限や記録は持たず、タイトルと完了だけ） -->
        <StackPanel Grid.Row="7" VerticalAlignment="Top" Margin="0,0,0,16">
            <TextBlock Text="サブタスク" Style="{StaticResource FieldLabelStyle}"/>
            <ItemsControl x:Name="SubtaskList" MaxHeight="120" Margin="0,0,0,6">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" Margin="0,0,8,0"
                                      VerticalAlignment="Center" Cursor="Hand"/>
                            <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBoxStyle}" FontSize="13"/>
                            <Button Grid.Column="2" Content="✕" Width="24" Height="24" Margin="4,0,0,0" Padding="0"
                                    Style="{StaticResource IconButtonStyle}" Cursor="Hand"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    ToolTip="このサブタスクを削除"
                                    Click="SubtaskDelete_Click"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SubtaskAddBox" Width="300" FontSize="13"
                         Style="{StaticResource InputTextBoxStyle}"
                         ToolTip="サブタスクを入力して Enter"
                         KeyDown="SubtaskAddBox_KeyDown"/>
                <Button Content="追加" Width="60" Height="30" Margin="8,0,0,0"
                        Click="SubtaskAddButton_Click" Style="{StaticResource BaseButtonStyle}"/>
            </StackPanel>
        </StackPanel>

        <!-- メモ -->
        <StackPanel Grid.Row="8" VerticalAlignment="Top">
            <TextBlock Text="メモ" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="ContentTextBox" Style="{StaticResource InputTextBoxStyle}" Height="90"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Width="100" Height="36" Margin="0,0,12,0"
                    IsCancel="True" Click="CancelButton_Click" Style="{StaticResource BaseButtonStyle}"/>
            <Button Content="OK" Width="100" Height="36" IsDefault="True"
                    Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
