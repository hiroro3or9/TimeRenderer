<Window x:Class="TimeRenderer.Views.Dialogs.ScheduleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="予定・実績の編集" Height="700" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 見出しと種類。主要な状態なので、説明文付きコンボではなく常時見える切替にする -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DialogHeadingText" Text="予定を追加" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="PlannedKindRadio" Content="予定" GroupName="ScheduleKind"
                             Width="86" IsChecked="True" Style="{StaticResource SegmentedLeftStyle}"
                             Checked="KindRadio_Changed"/>
                <RadioButton x:Name="RecordedKindRadio" Content="実績" GroupName="ScheduleKind"
                             Width="86" Style="{StaticResource SegmentedRightStyle}"
                             Checked="KindRadio_Changed"/>
            </StackPanel>
        </Grid>

        <!-- タイトル（手入力＋ドロップダウン候補：定型タイトル・直近1か月のタイトル） -->
        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="タイトル" Style="{StaticResource FieldLabelStyle}"/>
            <ComboBox x:Name="TitleCombo" IsEditable="True" FontSize="14" Padding="6,6"
                      IsTextSearchEnabled="False" MaxDropDownHeight="240"/>
        </StackPanel>

        <!-- 内容 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="内容" Style="{StaticResource FieldLabelStyle}"/>
            <TextBox x:Name="ContentTextBox" Style="{StaticResource InputTextBoxStyle}" Height="72"
                     TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- 日付・時刻・所要時間を一つのまとまりとして扱う -->
        <Border Grid.Row="3" Background="{DynamicResource MutedBackgroundBrush}" CornerRadius="8"
                Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="日付" Style="{StaticResource FieldLabelStyle}"/>
                        <DatePicker x:Name="DatePicker" Padding="4,4" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" x:Name="AllDayCheckBox" Content="終日"
                              Margin="16,0,0,4" VerticalAlignment="Bottom" VerticalContentAlignment="Center"
                              Checked="AllDayCheckBox_Changed" Unchecked="AllDayCheckBox_Changed"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="StartTimePanel">
                        <TextBlock Text="開始" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="StartHourCombo" Width="58" FontSize="14" Padding="6,6"
                                      SelectionChanged="TimeCombo_SelectionChanged"/>
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0" FontSize="16" FontWeight="Bold"/>
                            <ComboBox x:Name="StartMinuteCombo" Width="58" FontSize="14" Padding="6,6"
                                      SelectionChanged="TimeCombo_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="→" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Margin="0,0,0,8" Foreground="{DynamicResource TextMutedBrush}"/>

                    <StackPanel x:Name="EndTimePanel" Grid.Column="2">
                        <TextBlock Text="終了" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="EndHourCombo" Width="58" FontSize="14" Padding="6,6"
                                      SelectionChanged="TimeCombo_SelectionChanged"/>
                            <TextBlock Text=":" VerticalAlignment="Center" Margin="5,0" FontSize="16" FontWeight="Bold"/>
                            <ComboBox x:Name="EndMinuteCombo" Width="58" FontSize="14" Padding="6,6"
                                      SelectionChanged="TimeCombo_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="14,0,0,0" VerticalAlignment="Bottom">
                        <TextBlock Text="所要" Style="{StaticResource FieldLabelStyle}"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource PrimarySubtleBrush}" CornerRadius="10" Padding="8,4">
                                <TextBlock x:Name="DurationText" Text="1時間" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <Border x:Name="NextDayBadge" Background="{DynamicResource WarningSubtleBrush}"
                                    CornerRadius="10" Padding="8,4" Margin="6,0,0,0" Visibility="Collapsed">
                                <TextBlock Text="翌日" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 分類情報。カテゴリとプロジェクトコードを並べ、同じ文脈の入力として見せる -->
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="カテゴリ" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="ColorCombo" FontSize="14" Padding="6,6">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" Background="{Binding Brush}" CornerRadius="3" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="1">
                <TextBlock Text="プロジェクトコード" Style="{StaticResource FieldLabelStyle}"/>
                <ComboBox x:Name="ProjectCodeCombo" FontSize="14" Padding="6,6" DisplayMemberPath="DisplayName"/>
            </StackPanel>
        </Grid>

        <!-- 開始時の動作は排他的な3択にし、自動記録時だけ強制開始オプションを表示する -->
        <StackPanel x:Name="ReminderPanel" Grid.Row="5" VerticalAlignment="Top">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,12"/>
            <TextBlock Text="開始時の動作" Style="{StaticResource FieldLabelStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="NoStartActionRadio" Grid.Column="0" Content="何もしない" GroupName="StartAction"
                             IsChecked="True" Style="{StaticResource SegmentedLeftStyle}"/>
                <RadioButton x:Name="RemindStartActionRadio" Grid.Column="1" Content="通知" GroupName="StartAction"
                             Style="{StaticResource SegmentedMiddleStyle}"/>
                <RadioButton x:Name="AutoStartActionRadio" Grid.Column="2" Content="自動記録" GroupName="StartAction"
                             Style="{StaticResource SegmentedRightStyle}"/>
            </Grid>
            <CheckBox x:Name="ForceStartCheckBox" Content="記録中でも切り替える（現在の記録は停止・保存）"
                      Margin="8,10,0,0" VerticalContentAlignment="Center"
                      Visibility="{Binding IsChecked, ElementName=AutoStartActionRadio, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="キャンセル" Width="100" Height="36" Margin="0,0,12,0"
                    Click="CancelButton_Click" Style="{StaticResource BaseButtonStyle}"/>
            <Button Content="OK" Width="100" Height="36"
                    Click="OkButton_Click" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
