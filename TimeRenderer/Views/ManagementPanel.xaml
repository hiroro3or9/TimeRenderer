<UserControl x:Class="TimeRenderer.Views.ManagementPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- カテゴリ・定期予定・スプリントなど、アプリ設定とは別のデータ管理パネル -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="-4" Opacity="0.1"/>
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Width" Value="440"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsManagementPanelVisible}" Value="False">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="0" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Width" To="440" Duration="0:0:0.15">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Width="440">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}" Padding="16,12"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="管理" FontWeight="SemiBold" FontSize="16"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="分類・定期予定・スプリント" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Content="✕" Command="{Binding ToggleManagementPanelCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Style="{StaticResource IconButtonStyle}"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Style="{StaticResource SettingsTabControlStyle}">
                <!-- 分類マスター -->
                <TabItem Header="分類" Style="{StaticResource SettingsTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,6,20,24">
                            <Expander Style="{StaticResource SettingsExpanderStyle}" IsExpanded="True">
                                <Expander.Header>
                                    <TextBlock Text="カテゴリ" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="色に名前を付けて分類できます。カテゴリは統計にも反映されます"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox Grid.Column="0" Width="58" Margin="0,0,8,0"
                                                              ItemsSource="{Binding DataContext.PaletteColors, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedValuePath="Code" SelectedValue="{Binding ColorCode}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="22" Height="14" Background="{Binding Brush}" CornerRadius="3"
                                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                                        ToolTip="{Binding Name}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12"/>
                                                    <Button Grid.Column="2" Content="✕" Margin="4,0,0,0" Width="24" Height="24"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋ カテゴリを追加" Command="{Binding AddCategoryCommand}"
                                            Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch"/>

                                    <Separator Margin="0,14,0,10" Background="{DynamicResource BorderBrush}"/>
                                    <TextBlock Text="記録開始時の既定カテゴリ" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedRecordingCategory}"
                                              Height="32" Margin="0,0,0,4">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="20" Height="14" Background="{Binding Brush}" CornerRadius="3"
                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource SettingsExpanderStyle}">
                                <Expander.Header>
                                    <TextBlock Text="プロジェクトコード" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="案件・プロジェクト単位で集計するためのコードです"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding ProjectCodes}" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding Code, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12"
                                                             IsEnabled="{Binding IsActive}"/>
                                                    <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12" Margin="6,0,0,0"
                                                             IsEnabled="{Binding IsActive}"/>
                                                    <Button Grid.Column="2" Margin="4,0,0,0" Width="56" Height="26"
                                                            Command="{Binding DataContext.ToggleProjectCodeActiveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                                                <Setter Property="Content" Value="無効化"/>
                                                                <Setter Property="FontSize" Value="11"/>
                                                                <Setter Property="Padding" Value="4,2"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                        <Setter Property="Content" Value="有効化"/>
                                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Grid.Column="3" Content="✕" Margin="4,0,0,0" Width="24" Height="24"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding DataContext.DeleteProjectCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋ プロジェクトコードを追加" Command="{Binding AddProjectCodeCommand}"
                                            Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch"/>
                                    <TextBlock Text="既定のプロジェクトコード" Style="{StaticResource FieldLabelStyle}"
                                               Margin="0,14,0,6"/>
                                    <ComboBox ItemsSource="{Binding ActiveProjectCodes}"
                                              SelectedItem="{Binding SelectedDefaultProjectCode}"
                                              DisplayMemberPath="DisplayName" Height="32"/>
                                </StackPanel>
                            </Expander>

                            <Expander Style="{StaticResource SettingsExpanderStyle}">
                                <Expander.Header>
                                    <TextBlock Text="定型タイトル" Style="{StaticResource SettingsSectionHeaderStyle}"/>
                                </Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="タイトル入力欄の候補に常に表示されます"
                                               FontSize="11" Margin="0,0,0,10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{Binding PinnedTitles}" Margin="0,0,0,8">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource InputTextBoxStyle}" FontSize="12"/>
                                                    <Button Grid.Column="1" Content="✕" Margin="4,0,0,0" Width="24" Height="24"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            Command="{Binding DataContext.DeletePinnedTitleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="＋ 定型タイトルを追加" Command="{Binding AddPinnedTitleCommand}"
                                            Style="{StaticResource BaseButtonStyle}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- 定期予定 -->
                <TabItem Header="定期予定" Style="{StaticResource SettingsTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,24">
                            <TextBlock Text="決まった曜日や日付の予定を自動生成します。通知や自動記録開始も設定できます"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding Routines}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock FontSize="11" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding RecurrenceDisplay, Mode=OneWay}"/>
                                                        <Run Text="  "/>
                                                        <Run Text="{Binding TimeRangeDisplay, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <TextBlock Text="自動開始" FontSize="10" Foreground="{DynamicResource PrimaryBrush}"
                                                                   Visibility="{Binding IsAutoStart, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="無効" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                                   Visibility="{Binding IsEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="編集" Padding="7,4" Margin="0,0,4,0"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DataContext.EditRoutineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="削除" Padding="7,4"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            Command="{Binding DataContext.DeleteRoutineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="＋ 定期予定を追加" Command="{Binding AddRoutineCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- スプリント -->
                <TabItem Header="スプリント" Style="{StaticResource SettingsTabItemStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16,20,24">
                            <TextBlock Text="手動で期間を区切り、カレンダーとタイムラインの表示範囲に使います"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding ManualSprints}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="7" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock FontSize="11" Margin="0,3,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <Run Text="{Binding StartDate, StringFormat='yyyy/MM/dd', Mode=OneWay}"/>
                                                        <Run Text=" - "/>
                                                        <Run Text="{Binding EndDate, StringFormat='yyyy/MM/dd', Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="編集" Padding="7,4" Margin="0,0,4,0"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DataContext.EditManualSprintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="削除" Padding="7,4"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Foreground="{DynamicResource DangerBrush}"
                                                            Command="{Binding DataContext.DeleteManualSprintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="＋ スプリントを追加"
                                    Command="{Binding ShowAddSprintFormCommand}"
                                    Visibility="{Binding IsAddSprintFormVisible, Converter={StaticResource InvertedBooleanToVisibilityConverter}}"
                                    Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"/>

                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7"
                                    Padding="14" Background="{DynamicResource BackgroundBrush}"
                                    Visibility="{Binding IsAddSprintFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding FormTitle}" FontWeight="SemiBold" FontSize="14"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                                    <TextBlock Text="スプリント名" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox Text="{Binding NewSprintName, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource InputTextBoxStyle}" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="開始日" Style="{StaticResource FieldLabelStyle}"/>
                                            <DatePicker SelectedDate="{Binding NewSprintStartDate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="終了日" Style="{StaticResource FieldLabelStyle}"/>
                                            <DatePicker SelectedDate="{Binding NewSprintEndDate, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="キャンセル" Command="{Binding HideAddSprintFormCommand}"
                                                Style="{StaticResource BaseButtonStyle}"/>
                                        <Button Grid.Column="2" Content="保存" Command="{Binding SaveNewSprintCommand}"
                                                Style="{StaticResource PrimaryButtonStyle}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</UserControl>
