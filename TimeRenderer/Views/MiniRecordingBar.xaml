<Window x:Class="TimeRenderer.Views.MiniRecordingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="記録中"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="Manual"
        Opacity="0">

    <Window.Resources>
        <!--
            停止ボタン。ツールバーの IconButtonStyle はミニバーには大きすぎるため、
            この窓の中だけで使う小さいものを持つ。
        -->
        <Style x:Key="MiniBarStopButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="back" CornerRadius="4" Background="Transparent">
                            <!-- ツールバーの停止ボタンと同じ ■ にして、意味を覚え直さなくて済むようにする -->
                            <TextBlock Text="■" FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource DangerSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="back" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin は影の描画域。AllowsTransparency のため外側は透明のまま残る -->
    <Border x:Name="BarRoot" Margin="8"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            MouseLeftButtonDown="BarRoot_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="1" Direction="270" Opacity="0.28" Color="Black"/>
        </Border.Effect>

        <Border.ToolTip>
            <ToolTip Content="クリックで TimeRenderer を前面に／ドラッグで移動／右クリックでメニュー"/>
        </Border.ToolTip>

        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="TimeRenderer を表示" Click="ShowMainWindowMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="このバーを表示しない" Click="DisableMenuItem_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--
                記録中の内容の色。日/週ビューの帯と同じ色を使い、何を記録しているか色でも分かるようにする。
                外枠の角丸に食い込まないよう、縁に密着させず内側へ寄せている。
            -->
            <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="5,5,0,5"
                    Background="{Binding RecordingBrush}"/>

            <TextBlock Grid.Column="1" Text="{Binding RecordingDisplayTitle}"
                       MaxWidth="220" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       FontSize="12"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <TextBlock Grid.Column="2" Text="{Binding RecordingElapsedText}"
                       VerticalAlignment="Center" Margin="12,0,4,0"
                       FontSize="12" FontFamily="Consolas, Segoe UI"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <Button Grid.Column="3" Style="{StaticResource MiniBarStopButtonStyle}"
                    Margin="4,4,5,4"
                    Command="{Binding ToggleRecordingCommand}"
                    ToolTip="記録を停止する"/>
        </Grid>
    </Border>
</Window>
