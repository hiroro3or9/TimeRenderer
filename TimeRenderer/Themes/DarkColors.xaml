<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Colors (Blue based) -->
    <Color x:Key="PrimaryColor">#60A5FA</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <Color x:Key="PrimaryDarkColor">#93C5FD</Color>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <Color x:Key="PrimaryLightColor">#3B82F6</Color>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
    <Color x:Key="PrimarySubtleColor">#1E3A5F</Color>
    <SolidColorBrush x:Key="PrimarySubtleBrush" Color="{StaticResource PrimarySubtleColor}"/>

    <!-- 出勤・退勤マーカー（暗い背景でも沈まないよう明るめにする） -->
    <Color x:Key="WorkStartColor">#38BDF8</Color>
    <SolidColorBrush x:Key="WorkStartBrush" Color="{StaticResource WorkStartColor}"/>
    <Color x:Key="WorkEndColor">#A78BFA</Color>
    <SolidColorBrush x:Key="WorkEndBrush" Color="{StaticResource WorkEndColor}"/>

    <!-- 未記録の帯（暗い背景では塗りを少し強め、枠は沈まない明るさにする） -->
    <Color x:Key="UnrecordedGapColor">#26CBD5E1</Color>
    <SolidColorBrush x:Key="UnrecordedGapBrush" Color="{StaticResource UnrecordedGapColor}"/>
    <Color x:Key="UnrecordedGapBorderColor">#8094A3B8</Color>
    <SolidColorBrush x:Key="UnrecordedGapBorderBrush" Color="{StaticResource UnrecordedGapBorderColor}"/>

    <!-- Danger Colors (Red based) -->
    <!-- ToDo（期限の状態を示す色。暗い背景でも沈まないよう明度を上げる） -->
    <Color x:Key="TodoOverdueColor">#F87171</Color>
    <SolidColorBrush x:Key="TodoOverdueBrush" Color="{StaticResource TodoOverdueColor}"/>
    <Color x:Key="TodoDueTodayColor">#FBBF24</Color>
    <SolidColorBrush x:Key="TodoDueTodayBrush" Color="{StaticResource TodoDueTodayColor}"/>
    <Color x:Key="TodoHighPriorityColor">#FB923C</Color>
    <SolidColorBrush x:Key="TodoHighPriorityBrush" Color="{StaticResource TodoHighPriorityColor}"/>
    <!-- ToDo 通知バナーの地色（定期予定のリマインダーと見分けられるよう青系にしない） -->
    <Color x:Key="TodoReminderSubtleColor">#3A2E17</Color>
    <SolidColorBrush x:Key="TodoReminderSubtleBrush" Color="{StaticResource TodoReminderSubtleColor}"/>

    <Color x:Key="DangerColor">#F87171</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <Color x:Key="DangerDarkColor">#FCA5A5</Color>
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}"/>
    <Color x:Key="DangerSubtleColor">#2D1F1F</Color>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtleColor}"/>

    <!-- Warning Colors (Dark) -->
    <Color x:Key="WarningColor">#FBBF24</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <Color x:Key="WarningBorderColor">#D97706</Color>
    <SolidColorBrush x:Key="WarningBorderBrush" Color="{StaticResource WarningBorderColor}"/>
    <Color x:Key="WarningSubtleColor">#3A2E17</Color>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtleColor}"/>
    <Color x:Key="WarningTextColor">#FDE68A</Color>
    <SolidColorBrush x:Key="WarningTextBrush" Color="{StaticResource WarningTextColor}"/>

    <!-- Neutrals (Dark Theme) -->
    <Color x:Key="BackgroundColor">#0F172A</Color> <!-- Slate 900 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>

    <Color x:Key="MutedBackgroundColor">#0F172A</Color> <!-- Slate 900 -->
    <SolidColorBrush x:Key="MutedBackgroundBrush" Color="{StaticResource MutedBackgroundColor}"/>

    <Color x:Key="SurfaceColor">#1E293B</Color> <!-- Slate 800 -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>

    <Color x:Key="BorderColor">#334155</Color> <!-- Slate 700 -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <Color x:Key="TextPrimaryColor">#F1F5F9</Color> <!-- Slate 100 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>

    <Color x:Key="TextSecondaryColor">#94A3B8</Color> <!-- Slate 400 -->
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="TextMutedColor">#64748B</Color> <!-- Slate 500 -->
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>

    <!-- ホバー・押下・ハイライト用補助カラー (Dark) -->
    <Color x:Key="HoverBackgroundColor">#334155</Color> <!-- Slate 700 -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource HoverBackgroundColor}"/>
    <Color x:Key="PressedBackgroundColor">#1E293B</Color> <!-- Slate 800 -->
    <SolidColorBrush x:Key="PressedBackgroundBrush" Color="{StaticResource PressedBackgroundColor}"/>
    <Color x:Key="HoverBorderColor">#475569</Color> <!-- Slate 600 -->
    <SolidColorBrush x:Key="HoverBorderBrush" Color="{StaticResource HoverBorderColor}"/>

    <!-- ScrollBar Colors -->
    <Color x:Key="ScrollBarThumbColor">#40FFFFFF</Color> <!-- White with 25% opacity -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <Color x:Key="ScrollBarThumbHoverColor">#8CFFFFFF</Color> <!-- White with 55% opacity -->
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}"/>

</ResourceDictionary>
